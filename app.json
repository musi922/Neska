{
  "expo": {
    "name": "GEN Z",
    "slug": "GEN Z",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00B4D8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.genz.platform",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00B4D8"
      },
      "package": "com.genz.platform",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router", 
      "expo-font", 
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GEN Z to access your camera to take photos and videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GEN Z to access your photos to share them.",
          "savePhotosPermission": "Allow GEN Z to save photos to your library."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow GEN Z to access your microphone for voice messages and calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
